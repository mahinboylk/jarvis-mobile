# Groq API Key (for Whisper STT and Chat completions)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_key_here

# Fish Audio API Key & public Jarvis voice ID (for Custom TTS)
# Default public voice: Jarvis (MCU) J.A.R.V.I.S — 612b878b113047d9a770c069c8b4fdfe
# Uses free `s2.1-pro-free` backend tier, no private clone needed.
EXPO_PUBLIC_FISH_AUDIO_API_KEY=your_fish_audio_key_here
EXPO_PUBLIC_FISH_AUDIO_MODEL_ID=612b878b113047d9a770c069c8b4fdfe

# OPTIONAL — key-holding proxy (see proxy/README.md).
# When set, no Authorization header is sent from the device and the Groq/Fish
# keys above are never used. Unset (or empty) for direct provider calls.
# EXPO_PUBLIC_JARVIS_PROXY_URL=http://localhost:8787
