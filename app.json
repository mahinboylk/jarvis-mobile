{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "jarvis",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvis.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Jarvis requires microphone access to hear and transcribe your voice commands."
      }
    },
    "android": {
      "package": "com.jarvis.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Jarvis to access your microphone for voice assistant commands."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "hidden": true,
          "enforceContrast": false
        }
      ],
      "expo-splash-screen"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "display": "fullscreen",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    }
  }
}
